#!/bin/sh
# Two checks on what this commit adds (install once per clone: git config core.hooksPath scripts/hooks):
# - comment rule (AGENTS.md, Conventions): added comment lines hold no history, dates or measured numbers
#   (scripts/check-comments.mjs);
# - leak check: nothing of the developers' real repositories in the staged files (scripts/leak-check.mjs, word list
#   in the local .leak-check.json).
# Node 22 is needed; when `node` is older, nvm's 22 is used if nvm is installed.
node_ok() { command -v node >/dev/null 2>&1 && node -e 'process.exit(+process.versions.node.split(".")[0] >= 22 ? 0 : 1)'; }
if ! node_ok && [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
  . "${NVM_DIR:-$HOME/.nvm}/nvm.sh" >/dev/null 2>&1
  nvm use 22 >/dev/null 2>&1
fi
top="$(git rev-parse --show-toplevel)"
node "$top/scripts/check-comments.mjs" --staged || exit 1
exec node "$top/scripts/leak-check.mjs" --staged
