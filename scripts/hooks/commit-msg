#!/bin/sh
# Leak check on the commit message: no names of the developers' real repositories (scripts/leak-check.mjs).
# Install once per clone: git config core.hooksPath scripts/hooks
node_ok() { command -v node >/dev/null 2>&1 && node -e 'process.exit(+process.versions.node.split(".")[0] >= 22 ? 0 : 1)'; }
if ! node_ok && [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
  . "${NVM_DIR:-$HOME/.nvm}/nvm.sh" >/dev/null 2>&1
  nvm use 22 >/dev/null 2>&1
fi
exec node "$(git rev-parse --show-toplevel)/scripts/leak-check.mjs" --message "$1"
